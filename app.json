{
  "expo": {
    "name": "sim-somgande",
    "slug": "sim-somgande",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "simsomgande",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/dbfa1b75-c680-4b61-b58b-56f3a7e9c5c6",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#012036",
        "foregroundImage": "./assets/images/my-logo.png",
        "backgroundImage": "./assets/images/my-logo.png",
        "monochromeImage": "./assets/images/logo-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.opentech.simsomgande"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#220E02",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
         "icon": "./assets/images/notification-icon.png",
          "color": "#F37208", 
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbfa1b75-c680-4b61-b58b-56f3a7e9c5c6"
      }
    }
  }
}